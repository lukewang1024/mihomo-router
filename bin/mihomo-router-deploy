#!/bin/sh

set -eu

PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}
export PATH

SCRIPT_DIR=$(CDPATH='' cd "$(dirname "$0")" && pwd)
ROUTER_HOST=${MIHOMO_ROUTER_HOST:-}
SOURCE_DIR=${MIHOMO_ROUTER_SOURCE:-$(CDPATH='' cd "$SCRIPT_DIR/.." && pwd)}
SUBSCRIPTION_URL=
DEPLOY_SSH=${MIHOMO_ROUTER_SSH:-ssh}

usage() {
	cat <<'EOF'
usage:
  mihomo-router-deploy bootstrap --host HOST --subscription-url URL
  mihomo-router-deploy bootstrap --host HOST --subscription-stdin
  mihomo-router-deploy update --host HOST [--subscription-url URL|--subscription-stdin]
  mihomo-router-deploy upgrade --host HOST
  mihomo-router-deploy restart --host HOST
  mihomo-router-deploy status --host HOST
  mihomo-router-deploy gateway --host HOST init|check|status|list-json|remove ALIAS
  mihomo-router-deploy gateway --host HOST use DEVICE
  mihomo-router-deploy tailscale-install --host HOST
  mihomo-router-deploy tailscale-register --host HOST
  mihomo-router-deploy tailscale-status --host HOST
  mihomo-router-deploy tailscale-exit-node --host HOST enable|disable

Environment:
  MIHOMO_ROUTER_HOST    SSH host, required unless --host is supplied
  MIHOMO_ROUTER_SOURCE  mihomo-router checkout (default: this repository)
  MIHOMO_ROUTER_SSH     SSH executable (default: ssh)
EOF
}

die() {
	printf '%s\n' "mihomo-router-deploy: ERROR: $*" >&2
	exit 1
}

validate_gateway_cli_name() {
	printf '%s\n' "$1" | awk 'length($0)>0 && length($0)<=48 && $0 ~ /^[A-Za-z0-9]([A-Za-z0-9_. -]*[A-Za-z0-9])?$/ { ok=1 } END { exit !ok }' || die "invalid gateway device name"
}

read_subscription_stdin() {
	IFS= read -r SUBSCRIPTION_URL || :
	[ -n "$SUBSCRIPTION_URL" ] || die "subscription URL is empty"
}

set_subscription() {
	[ -n "$SUBSCRIPTION_URL" ] || return 0
	case "$SUBSCRIPTION_URL" in
		*"'"*) die "subscription URL cannot contain a single quote" ;;
	esac
	# Send the secret through SSH stdin. It is not part of the remote command
	# line and is never printed by this wrapper.
	{
		printf '%s\n' "$SUBSCRIPTION_URL"
		cat <<'REMOTE_SCRIPT'
set -eu
config=/data/mihomo-router/router.conf
tmp=$config.new
awk -v url="$url" '
	/^SUBSCRIPTION_URL=/ { print "SUBSCRIPTION_URL=\047" url "\047"; found=1; next }
	{ print }
	END { if (!found) print "SUBSCRIPTION_URL=\047" url "\047" }
' "$config" >"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$config"
REMOTE_SCRIPT
	} | "$DEPLOY_SSH" "$ROUTER_HOST" 'IFS= read -r url; export url; sh -s'
}

upload_runtime() {
	[ -x "$SOURCE_DIR/bin/mihomo-router" ] || die "missing $SOURCE_DIR/bin/mihomo-router"
	[ -r "$SOURCE_DIR/openwrt/mihomo-router.init" ] || die "missing OpenWrt init script"
	[ -r "$SOURCE_DIR/etc/mihomo-router.conf.example" ] || die "missing config example"
	[ -r "$SOURCE_DIR/share/domestic-overlay.awk" ] || die "missing domestic overlay"
	"$DEPLOY_SSH" "$ROUTER_HOST" 'mkdir -p /tmp/mihomo-router-upload; chmod 700 /tmp/mihomo-router-upload'

	scp -O \
		"$SOURCE_DIR/bin/mihomo-router" \
		"$SOURCE_DIR/bin/mihomo-router-boot" \
		"$SOURCE_DIR/bin/mihomo-router-boot-include" \
		"$SOURCE_DIR/install.sh" \
		"$SOURCE_DIR/share/ai-overlay.awk" \
		"$SOURCE_DIR/share/panel.sh" \
		"$SOURCE_DIR/share/domestic-overlay.awk" \
		"$SOURCE_DIR/share/ui/index.html" \
		"$SOURCE_DIR/share/ssh-gateway.sh" \
		"$SOURCE_DIR/share/cgi-bin/gateway-admin" \
		"$SOURCE_DIR/share/ssh-gateway-overlay.awk" \
		"$SOURCE_DIR/openwrt/mihomo-router-admin.init" \
		"$SOURCE_DIR/etc/ssh-gateways.yaml.example" \
		"$SOURCE_DIR/openwrt/mihomo-router.init" \
		"$SOURCE_DIR/etc/mihomo-router.conf.example" \
		"$ROUTER_HOST:/tmp/mihomo-router-upload/"

	# Expand this script on the router, not in the upload client.
	# shellcheck disable=SC2016
	"$DEPLOY_SSH" "$ROUTER_HOST" '
		set -eu
		stage=/tmp/mihomo-router-upload
		mkdir -p "$stage/bin" "$stage/share/ui" "$stage/share/cgi-bin" "$stage/openwrt" "$stage/etc"
		mv "$stage/index.html" "$stage/share/ui/index.html"
		mv "$stage/gateway-admin" "$stage/share/cgi-bin/gateway-admin"
		mv "$stage/mihomo-router-admin.init" "$stage/openwrt/mihomo-router-admin.init"
		mv "$stage/mihomo-router" "$stage/mihomo-router-boot" "$stage/mihomo-router-boot-include" "$stage/bin/"
		mv "$stage/ai-overlay.awk" "$stage/panel.sh" "$stage/domestic-overlay.awk" "$stage/ssh-gateway.sh" "$stage/ssh-gateway-overlay.awk" "$stage/share/"
		mv "$stage/ssh-gateways.yaml.example" "$stage/etc/"
		mv "$stage/mihomo-router.init" "$stage/openwrt/"
		mv "$stage/mihomo-router.conf.example" "$stage/etc/"
		sh "$stage/install.sh" --root /
		rm -rf "$stage"
	'
}

merge_geodata_defaults() {
	"$DEPLOY_SSH" "$ROUTER_HOST" 'sh -s' <<'REMOTE_SCRIPT'
set -eu
config=/data/mihomo-router/router.conf
example=/data/mihomo-router/share/mihomo-router.conf.example
tmp=$config.new
awk '
	BEGIN { keys[1]="MMDB_FILE"; keys[2]="MMDB_URL"; keys[3]="MMDB_SHA256"; keys[4]="MMDB_TLS_INSECURE" }
	/^([A-Z0-9_]+)=/ { seen[substr($0, 1, index($0, "=") - 1)]=1 }
	{ print }
	END {
		for (i=1; i<=4; i++) if (!seen[keys[i]]) {
			while ((getline line < example) > 0) if (line ~ ("^" keys[i] "=")) print line
			close(example)
		}
	}
' "$config" >"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$config"
REMOTE_SCRIPT
}

upload_tailscale() {
	tailscale_dir=$SOURCE_DIR/contrib/tailscale
	[ -r "$tailscale_dir/install.sh" ] || die "missing Tailscale installer"
	[ -r "$tailscale_dir/tailscaled-1.104.1-ax3600-minimal-arm64.xz" ] || die "missing pinned Tailscale archive"
	[ -r "$tailscale_dir/tailscaled-1.104.1-ax3600-minimal-arm64.xz.sha256" ] || die "missing archive checksum"
	[ -r "$tailscale_dir/tailscaled.sha256" ] || die "missing binary checksum"
	[ -r "$tailscale_dir/tailscale-control.sh" ] || die "missing Tailscale controller"
	"$DEPLOY_SSH" "$ROUTER_HOST" 'mkdir -p /tmp/mihomo-router-tailscale-upload; chmod 700 /tmp/mihomo-router-tailscale-upload'
	scp -O \
		"$tailscale_dir/install.sh" \
		"$tailscale_dir/tailscaled-1.104.1-ax3600-minimal-arm64.xz" \
		"$tailscale_dir/tailscaled-1.104.1-ax3600-minimal-arm64.xz.sha256" \
		"$tailscale_dir/tailscaled.sha256" \
		"$tailscale_dir/tailscale-control.sh" \
		"$tailscale_dir/bin/boot-run.sh" \
		"$tailscale_dir/bin/run.sh" \
		"$tailscale_dir/bin/migrate-to-user.sh" \
		"$tailscale_dir/bin/boot-include" \
		"$tailscale_dir/openwrt/tailscale-wol.init" \
		"$ROUTER_HOST:/tmp/mihomo-router-tailscale-upload/"
	"$DEPLOY_SSH" "$ROUTER_HOST" '
		set -eu
		stage=/tmp/mihomo-router-tailscale-upload
		trap '\''rm -rf "$stage"'\'' 0
		mkdir -p "$stage/bin" "$stage/openwrt"
		mv "$stage/boot-run.sh" "$stage/run.sh" "$stage/migrate-to-user.sh" "$stage/boot-include" "$stage/bin/"
		mv "$stage/tailscale-wol.init" "$stage/openwrt/"
		sh "$stage/install.sh"
	'
	printf '%s\n' "Tailscale client installed on $ROUTER_HOST; registration remains a separate step."
}

bootstrap_router() {
	[ -n "$SUBSCRIPTION_URL" ] || die "bootstrap requires --subscription-url or --subscription-stdin"
	upload_runtime
	merge_geodata_defaults
	set_subscription
	"$DEPLOY_SSH" "$ROUTER_HOST" '
		set -eu
		/data/mihomo-router/bin/mihomo-router update
		/data/mihomo-router/bin/mihomo-router-boot restart
	'
	printf '%s\n' "mihomo-router bootstrapped and restarted on $ROUTER_HOST"
}

update_router() {
	set_subscription
	"$DEPLOY_SSH" "$ROUTER_HOST" '
		set -eu
		/data/mihomo-router/bin/mihomo-router update
		/data/mihomo-router/bin/mihomo-router-boot restart
	'
	printf '%s\n' "mihomo-router updated and restarted on $ROUTER_HOST"
}

upgrade_router() {
	upload_runtime
	merge_geodata_defaults
	set_subscription
	"$DEPLOY_SSH" "$ROUTER_HOST" 'set -eu; /data/mihomo-router/bin/mihomo-router-boot restart'
	printf '%s\n' "mihomo-router runtime upgraded and restarted on $ROUTER_HOST"
}

command_name=${1:-}
[ -n "$command_name" ] || { usage >&2; exit 2; }
shift

while [ "$#" -gt 0 ]; do
	case "$1" in
		--subscription-url)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			SUBSCRIPTION_URL=$2
			shift 2
			;;
		--subscription-stdin)
			read_subscription_stdin
			shift
			;;
		--host)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			ROUTER_HOST=$2
			shift 2
			;;
		--source)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			SOURCE_DIR=$2
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			break
			;;
		*)
			case "$command_name" in gateway|tailscale-exit-node) break ;; esac
			usage >&2
			exit 2
			;;
	esac
done

[ -n "$ROUTER_HOST" ] || die "router host is required; use --host or MIHOMO_ROUTER_HOST"

case "$command_name" in
	bootstrap) bootstrap_router ;;
	update) update_router ;;
	upgrade) upgrade_router ;;
	restart) "$DEPLOY_SSH" "$ROUTER_HOST" '/data/mihomo-router/bin/mihomo-router-boot restart' ;;
	status) "$DEPLOY_SSH" "$ROUTER_HOST" '/data/mihomo-router/bin/mihomo-router status' ;;
	tailscale-install) upload_tailscale ;;
	tailscale-register) "$DEPLOY_SSH" "$ROUTER_HOST" '/data/tailscale-wol/tailscale-control.sh register' ;;
	tailscale-status) "$DEPLOY_SSH" "$ROUTER_HOST" '/data/tailscale-wol/tailscale-control.sh status' ;;
	tailscale-exit-node)
		case ${1:-} in enable|disable) ;; *) die "tailscale-exit-node requires enable or disable" ;; esac
		[ "$#" -eq 1 ] || die "tailscale-exit-node takes one action"
		"$DEPLOY_SSH" "$ROUTER_HOST" "/data/tailscale-wol/tailscale-control.sh exit-node $1"
		;;
	gateway)
		case ${1:-} in
			init|check|status|list-json)
				[ "$#" -eq 1 ] || die "gateway action takes no extra arguments"
				"$DEPLOY_SSH" "$ROUTER_HOST" "/data/mihomo-router/bin/mihomo-router gateway $1"
				;;
			remove)
				[ "$#" -eq 2 ] || die "gateway remove requires an alias"
				validate_gateway_cli_name "$2"
				"$DEPLOY_SSH" "$ROUTER_HOST" "/data/mihomo-router/bin/mihomo-router gateway remove '$2'"
				;;
			use)
				[ "$#" -eq 2 ] || die "gateway use requires a device name"
				validate_gateway_cli_name "$2"
				"$DEPLOY_SSH" "$ROUTER_HOST" "/data/mihomo-router/bin/mihomo-router gateway use '$2'"
				;;
			*) die "gateway requires init, check, status, list-json, use DEVICE or remove ALIAS" ;;
		esac
		;;
	*) usage >&2; exit 2 ;;
esac
