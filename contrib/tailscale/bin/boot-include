#!/bin/sh

set -eu

DATA=/data/tailscale-wol
RUN=/tmp/tailscale-wol
mkdir -p "$RUN"

(
	lock=$RUN/boot.lock
	mkdir "$lock" 2>/dev/null || exit 0
	trap 'rmdir "$lock" 2>/dev/null || :' 0
	cp "$DATA/share/tailscale-wol.init" /etc/init.d/tailscale-wol.new
	chmod 755 /etc/init.d/tailscale-wol.new
	mv /etc/init.d/tailscale-wol.new /etc/init.d/tailscale-wol
	/etc/init.d/tailscale-wol enable >/dev/null 2>&1 || :
	/etc/init.d/tailscale-wol start
) >>"$RUN/boot.log" 2>&1 </dev/null &
