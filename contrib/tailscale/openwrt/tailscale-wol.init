#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

ensure_tailscale_user() {
	if awk -F: '$1 == "tsnet" { ok = ($3 == 454 && $4 == 65534); found = 1 } END { exit !(found && ok) }' /etc/passwd; then
		return 0
	fi
	if grep -q '^tsnet:' /etc/passwd || awk -F: '$3 == 454 { found = 1 } END { exit !found }' /etc/passwd; then
		return 1
	fi
	printf '%s\n' 'tsnet:x:454:65534:Tailscale userspace daemon:/var/empty:/bin/false' >> /etc/passwd
}

start_service() {
	[ -x /data/tailscale-wol/bin/boot-run.sh ] || return 1
	ensure_tailscale_user || return 1
	mkdir -p /data/tailscale-wol/state /tmp/tailscale-wol
	chmod 755 /data/tailscale-wol /data/tailscale-wol/bin
	chmod 700 /data/tailscale-wol/state /tmp/tailscale-wol
	chown -R 454:65534 /data/tailscale-wol/state
	chown -R 454:65534 /tmp/tailscale-wol
	procd_open_instance
	procd_set_param user tsnet
	procd_set_param command /data/tailscale-wol/bin/boot-run.sh
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/data/tailscale-wol/tailscale-control.sh stop
}
