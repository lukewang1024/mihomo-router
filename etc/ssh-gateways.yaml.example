# Copy device entries into DATA_DIR/gateways/proxies.yaml (mode 600).
# Use stable DHCP reservations or LAN DNS names; never commit real credentials.
# Each endpoint must allow TCP forwarding and reach the target network itself.
proxies:
  - name: phone-a
    type: ssh
    server: 192.168.31.100
    port: 8022
    username: replace-with-termux-username
    private-key: /data/mihomo-router/ssh/gateway_ed25519
    host-key-algorithms:
      - ssh-ed25519
    host-key:
      - 'ssh-ed25519 REPLACE_WITH_VERIFIED_HOST_PUBLIC_KEY'
  - name: laptop-b
    type: ssh
    server: 192.168.31.101
    port: 22
    username: replace-with-ssh-username
    private-key: /data/mihomo-router/ssh/gateway_ed25519
    host-key-algorithms:
      - ssh-ed25519
    host-key:
      - 'ssh-ed25519 REPLACE_WITH_VERIFIED_HOST_PUBLIC_KEY'
