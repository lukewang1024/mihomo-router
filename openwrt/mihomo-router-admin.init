#!/bin/sh /etc/rc.common

START=98
STOP=11
USE_PROCD=1

start_service() {
    config=/data/mihomo-router/router.conf
    [ -r "$config" ] || return 0
    # shellcheck disable=SC1090
    . "$config"
    [ "${SSH_GATEWAY_ENABLED:-0}" = 1 ] || return 0
    [ -x /usr/sbin/uhttpd ] || {
        echo 'mihomo-router-admin: uhttpd is unavailable' >&2
        return 1
    }
    case ${CONTROLLER_ADDRESS:-} in
        *:*:*) echo 'mihomo-router-admin: requires an IPv4 controller address' >&2; return 1 ;;
        *:*) bind=${CONTROLLER_ADDRESS%:*} ;;
        *) echo 'mihomo-router-admin: invalid controller address' >&2; return 1 ;;
    esac
    case "$bind" in ''|*[!0-9.]*) echo 'mihomo-router-admin: invalid bind address' >&2; return 1 ;; esac
    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -c /dev/null -p "$bind:19091" -h /data/mihomo-router/admin-http -x /cgi-bin -t 5 -T 30
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /data/mihomo-router/router.conf
    procd_close_instance
}
