#!/bin/sh /etc/rc.common

# rc.common consumes these variables.
# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

PROG=/data/mihomo-router/bin/mihomo-router

start_service() {
	[ ! -e /data/mihomo-router/.disabled ] || return 0
	/data/mihomo-router/bin/mihomo-router-boot disable-shellcrash || return 1
	/data/mihomo-router/bin/mihomo-router-boot setup || return 1
	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param env MIHOMO_ROUTER_CONFIG=/data/mihomo-router/router.conf
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /data/mihomo-router/router.conf
	procd_close_instance
}

stop_service() {
	"$PROG" firewall-down
}

reload_service() {
	"$PROG" update && /data/mihomo-router/bin/mihomo-router-boot restart
}
